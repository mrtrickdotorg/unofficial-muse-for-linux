FROM docker.io/library/ubuntu:24.04

# Ubuntu 24.04 is the builder base on purpose (Patrick's call,
# Nov 13, 2026): the AppImage bundles this container's GTK, and
# bookworm's GTK 4.8 measured conversations so much slower than
# 4.14 that chat switches locked the app for seconds on the
# reader's laptop while a throttled VM on 4.14 settled the same
# shapes in a fraction of the time. The cost is the glibc floor:
# binaries built here need a host glibc >= 2.39.

ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        build-essential \
        ca-certificates \
        curl \
        dbus \
        desktop-file-utils \
        dpkg-dev \
        file \
        git \
        libfuse2t64 \
        libgdk-pixbuf2.0-bin \
        libglib2.0-bin \
        libgtk-4-dev \
        libwebkitgtk-6.0-dev \
        patchelf \
        librsvg2-dev \
        pkg-config \
        python3 \
        python3-venv \
        xauth \
        xvfb \
        squashfs-tools \
        xz-utils \
        zsync \
    && rm -rf /var/lib/apt/lists/*

# The Rust toolchain stays pinned at 1.99, as the old rust: base
# pinned it; Ubuntu's repositories do not carry it, so rustup
# installs it. CI overrides CARGO_HOME with its cache mount at
# run time; RUSTUP_HOME is not overridden, so the toolchain the
# shims resolve stays this one.
ENV RUSTUP_HOME=/usr/local/rustup CARGO_HOME=/usr/local/cargo
RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs \
    | sh -s -- -y --default-toolchain 1.99 --profile minimal \
    && /usr/local/cargo/bin/rustup component add rustfmt clippy
ENV PATH=/usr/local/cargo/bin:$PATH

# Test-only pinned community runtime: real protobuf contracts, fake network IO.
# This builder dependency is never copied into the distributable AppImage.
COPY scripts/setup-account-bridge.sh /usr/local/libexec/setup-muse-test-bridge.sh
RUN useradd --create-home --home-dir /opt/muse-test muse-test \
    && runuser -u muse-test -- bash /usr/local/libexec/setup-muse-test-bridge.sh \
        --prefix /opt/muse-test/account-bridge
ENV MUSE_ACCOUNT_TEST_PYTHON=/opt/muse-test/account-bridge/.venv/bin/python

WORKDIR /workspace
