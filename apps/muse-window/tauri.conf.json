{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Muse Shell Window",
  "version": "0.1.0",
  "identifier": "org.kythos.MuseWindow",
  "build": {},
  "app": {
    "windows": [],
    "security": {
      "csp": null,
      "capabilities": []
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb"],
    "category": "Utility",
    "shortDescription": "The Muse app's shell window",
    "longDescription": "Muse's shell window: the app's own pages in a Tauri 2 window. It owns no state of its own and is started by the Muse app, which answers its pages, so the desktop entry is hidden and the window is installed as a component beside the app.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png"
    ],
    "linux": {
      "deb": {
        "desktopTemplate": "icons/muse-window.desktop"
      }
    }
  }
}
